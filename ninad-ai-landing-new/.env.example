# Backend API base URL (default remote backend)
NEXT_PUBLIC_API_URL=

# Secondary backend used for specific creators' voice WebSocket sessions (e.g. api-ninad-2.duckdns.org)
NEXT_PUBLIC_NINAD_2_API_URL=

# Set true to use localhost backend instead of remote backend
NEXT_PUBLIC_USE_LOCAL_API=false
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:8000

# Optional frontend fallback if backend does not return key_id in order response
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth2 — must match the client ID registered in Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=